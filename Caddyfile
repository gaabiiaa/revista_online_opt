revista-online-opt.onrender.com {
    # Rezolva eroarea 403: Caddy accepta explicit domeniul Render.
    
    # Serveste fisiere statice
    root * /var/www/html
    file_server

    # Rezolva eroarea 502/socket: Comunica cu PHP-FPM pe TCP (Port 9000)
    php_fastcgi 127.0.0.1:9000 {
        root /var/www/html
        index index.php
    }

    # Fallback la index.php pentru rute (daca aplicatia este un framework)
    try_files {path} /index.php?{query}
}
